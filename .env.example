# Порт и хост
PORT=8788
HOST=0.0.0.0
NODE_ENV=production

# Папка данных. Локально можно не задавать (будет ./data на этом ПК).
DATA_DIR=

# Postgres (на Render подключается сам через render.yaml).
# Локально опционально: postgresql://user:pass@localhost:5432/tls
DATABASE_URL=

# Обязательно смени перед деплоем — пароли нигде в репозитории не хранятся
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
OPERATOR_LOGIN=operator
OPERATOR_PASSWORD=
