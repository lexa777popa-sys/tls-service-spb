{
  "name": "tls-service-spb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.5",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/manrope": "^5.2.5",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "concurrently": "^9.2.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
